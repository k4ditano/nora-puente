// La hoja del extra «Nora» en la barra de Bahía: la consola RG35XX con Nora OS. Batería, qué app tiene abierta, cómo
// está conectada, y volumen y brillo con − y +. Bahía dibuja la píldora (con lo que dice `nora-puente seguir`) y abre
// esto debajo (extras/GUIDE.md de Bahía). Lo instala nora-puente cuando ve que usas Bahía: no lo edites aquí, se
// sobrescribe; sus fuentes están en el repo de nora-puente, bahia/.
language 0.1
import "lib/kit.plm"
import "lib/extra-kit.plm"
scene NoraHoja {
    fact xsw = 320
    fact xsh = 248
    surface { size: 384, 320; anchor: top_left; level: overlay; margin: xtop, 0, 0, xleft; screens: xscreen; open: xp > 0.01 }
    permissions { run: "{{PUENTE}} seguir" }
    fact puente = false
    fact conectada = false
    fact bat = -1
    fact cargando = false
    text bat_txt = "—"
    text linea1 = "Buscando a nora-puente…"
    text linea2 = ""
    text estado_txt = "Desconectada"
    text vol_txt = "—"
    text bri_txt = "—"
    event vol_menos ->
    event vol_mas ->
    event bri_menos ->
    event bri_mas ->
    include "lib/extra-base.plm"

    let x0 = xsx + 16
    let iw = xsw - 32
    Sheet() {
        Header("NORA · RG35XX", x0, xsy + 16, 160)
        ellipse { at: xsx + xsw - 20, xsy + 24; radius: 4; color: if(conectada, #34c759, wdim) }
        text estado_txt { at: xsx + xsw - 32, xsy + 24; anchor: right center; size: 11; weight: 600; family: "Inter"; color: wdim; width: 120; lines: 1; align: right }

        Big(bat_txt, x0, xsy + 40, iw, 40)
        box { from: x0, xsy + 88; size: iw, 6; corner: 3; color: wink; opacity: 10%; show: conectada and bat >= 0 }
        box { from: x0, xsy + 88; size: max(iw * clamp(bat / 100, 0, 1), 6), 6; corner: 3; color: if(bat < 20, #ff3b30, #34c759); show: conectada and bat >= 0 }
        Label(linea1, x0, xsy + 104, iw, 13)
        Label(linea2, x0, xsy + 128, iw, 11, true)

        group {
            show: conectada
            Rule(xsy + 160, x0, iw)
            Label("Volumen", x0, xsy + 182, 120, 13)
            Button("−", xsx + xsw - 16 - 104, xsy + 176, vol_menos, 28)
            text vol_txt { at: xsx + xsw - 16 - 52, xsy + 190; anchor: center; size: 13; weight: 600; family: "Inter"; color: wink; width: 40; lines: 1; align: center }
            Button("+", xsx + xsw - 16 - 28, xsy + 176, vol_mas, 28)
            Label("Brillo", x0, xsy + 214, 120, 13)
            Button("−", xsx + xsw - 16 - 104, xsy + 208, bri_menos, 28)
            text bri_txt { at: xsx + xsw - 16 - 52, xsy + 222; anchor: center; size: 13; weight: 600; family: "Inter"; color: wink; width: 40; lines: 1; align: center }
            Button("+", xsx + xsw - 16 - 28, xsy + 208, bri_mas, 28)
        }
    }
}
